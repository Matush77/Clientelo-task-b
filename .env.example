# Copy to .env.local for local testing (never commit real values).
# Without these, the app falls back to an in-memory store and logs e-mails to the console.

# Upstash Redis (added automatically when the Upstash integration is connected in Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Brevo transactional e-mail
BREVO_API_KEY=
MAIL_FROM=            # verified sender address in Brevo
MAIL_FROM_NAME=Veenos
TEAM_EMAIL=           # receives "Chci pomoct" call-back requests

# Protects /api/stats (any long random string)
STATS_TOKEN=

# Optional trackers. Loaded only after cookie consent; empty = inactive.
GA4_ID=
META_PIXEL_ID=
